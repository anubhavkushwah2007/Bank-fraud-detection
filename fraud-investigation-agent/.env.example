# HHGOA Fraud Investigation Agent — Environment Template
# Copy this file to .env and fill in your values.

# ─── TigerGraph ─────────────────────────────────────────────────────────────
# Set DEMO_MODE=false and fill these to connect to a live TigerGraph instance.
DEMO_MODE=true
TIGERGRAPH_HOST=http://localhost
TIGERGRAPH_PORT=14240
TIGERGRAPH_GRAPH=FraudGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=

# ─── LLM ────────────────────────────────────────────────────────────────────
# Choose one provider and fill in the corresponding API key.
# Without a key the system uses heuristic mode (fully offline).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Risk Thresholds ────────────────────────────────────────────────────────
FRAUD_THRESHOLD=0.75
UNCERTAINTY_THRESHOLD=0.40
SAR_THRESHOLD=0.85

# ─── Vector Store ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_SIMILAR_CASES=5

# ─── Agent ──────────────────────────────────────────────────────────────────
MAX_EVIDENCE_RETRIES=2
HOP_DEPTH=2
