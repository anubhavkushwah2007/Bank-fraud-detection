// ============================================================
// HHGOA Fraud Investigation System — TigerGraph Schema
// Graph Schema for Competition Benchmark & Real Dataset
// ============================================================

// ------------------------------------------------------------
// VERTEX DEFINITIONS
// ------------------------------------------------------------

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card4 STRING DEFAULT "",
    card6 STRING DEFAULT ""
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    ts DATETIME,
    TransactionAmt FLOAT,
    ProductCD STRING,
    channel STRING,
    risk_score FLOAT DEFAULT 0.0,
    addr1 STRING DEFAULT "",
    addr2 STRING DEFAULT "",
    dist1 FLOAT DEFAULT 0.0,
    P_emaildomain STRING DEFAULT "",
    card4 STRING DEFAULT "",
    card6 STRING DEFAULT "",
    id_15 STRING DEFAULT "",
    id_23 STRING DEFAULT "",
    DeviceType STRING DEFAULT "",
    C1 FLOAT DEFAULT 0.0,
    C2 FLOAT DEFAULT 0.0,
    D1 FLOAT DEFAULT 0.0,
    M1 STRING DEFAULT "",
    M2 STRING DEFAULT "",
    M3 STRING DEFAULT "",
    M4 STRING DEFAULT "",
    M5 STRING DEFAULT "",
    M6 STRING DEFAULT "",
    M7 STRING DEFAULT "",
    M8 STRING DEFAULT "",
    M9 STRING DEFAULT ""
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_id STRING,
    device_info STRING DEFAULT "",
    id_30 STRING DEFAULT "",
    id_31 STRING DEFAULT "",
    id_33 STRING DEFAULT ""
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    status STRING DEFAULT "CLOSED",
    verdict STRING DEFAULT "",
    pattern STRING DEFAULT "",
    fraud_probability FLOAT DEFAULT 0.0,
    total_exposure FLOAT DEFAULT 0.0,
    analyst_notes STRING DEFAULT ""
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Case (
    PRIMARY_ID case_id STRING,
    status STRING DEFAULT "OPEN",
    verdict STRING DEFAULT "UNDECIDED",
    fraud_probability FLOAT DEFAULT 0.0,
    pattern STRING DEFAULT "",
    exposure_usd FLOAT DEFAULT 0.0,
    summary STRING DEFAULT "",
    opened_at DATETIME,
    updated_at DATETIME,
    customer_id STRING DEFAULT "",
    card_id STRING DEFAULT "",
    sar_required BOOL DEFAULT FALSE,
    sar_draft STRING DEFAULT ""
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// ------------------------------------------------------------
// EDGE DEFINITIONS
// ------------------------------------------------------------

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="reverse_OWNS";
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="reverse_MADE";
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="reverse_FROM_DEVICE";
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="reverse_PURCHASER_EMAIL";
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="reverse_BILLED_IN";
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, interval_sec INT DEFAULT 0) WITH REVERSE_EDGE="reverse_NEXT";

CREATE DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="reverse_CC_INVOLVES";
CREATE DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="reverse_CC_ON_CARD";

CREATE DIRECTED EDGE CASE_INVOLVES (FROM Case, TO Transaction) WITH REVERSE_EDGE="reverse_CASE_INVOLVES";
CREATE DIRECTED EDGE CASE_ON_CARD (FROM Case, TO Card) WITH REVERSE_EDGE="reverse_CASE_ON_CARD";
CREATE DIRECTED EDGE CASE_SIMILAR_TO (FROM Case, TO ClosedCase, similarity FLOAT DEFAULT 0.0) WITH REVERSE_EDGE="reverse_CASE_SIMILAR_TO";
CREATE UNDIRECTED EDGE CASE_SIMILAR_CASE (FROM Case, TO Case, similarity FLOAT DEFAULT 0.0);
